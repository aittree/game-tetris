# ============================================================
# 俄罗斯方块 桌面版（Python + pygame）· Git 忽略规则
# 项目：games/game-tetris    开发工具：IntelliJ IDEA / PyCharm
# ============================================================

# ---------- Python 字节码与编译产物 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo

# ---------- 虚拟环境 ----------
# 本项目统一使用 miniconda 的 game 环境（位于 conda 安装目录，不在工程内），
# 下列规则仅用于防止他人误建 venv 后把整目录提交上来。
.venv/
venv/
env/
ENV/
.python-version

# ---------- 依赖与构建产物 ----------
# PyInstaller / 打包输出
build/
dist/
*.manifest
*.spec
*.spec.bak
# 打包配置与版本信息是构建入口，必须入库
!tetris.spec
!version_info.txt

# 通用分发产物
*.egg-info/
*.egg
wheels/
sdist/
downloads/
MANIFEST

# 生成的 exe（源码运行不需要；发布产物单独归档）
*.exe

# ---------- 测试与静态检查缓存 ----------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.tox/
.nox/
.ruff_cache/
.mypy_cache/
.dmypy.json
.pytype/
.pyre/

# ---------- 运行期产物与日志 ----------
*.log
crash.log
# 存档实际写入 %APPDATA%\TetrisDesktop\save.json；
# 若调试时改为写到工程内，也不入库
save.json
save.tmp

# ---------- 素材源文件与临时工作区 ----------
# _src/ 存放 AI 生成的原图（约 8 MB），可由 tools/ 下的脚本重新处理，不入库
_src/
# scratch/ 放临时脚本与实验代码
scratch/
# 文档/截图/素材的中间产物
*.tmp
*.bak
~$*

# ---------- JetBrains IDEA / PyCharm ----------
# 整目录忽略：workspace.xml、tasks.xml、shelf/、本地历史、运行配置等均为本机个人数据。
# 若以后需要团队共享代码风格，把下面一行替换为：
#   .idea/*
#   !.idea/codeStyles/
#   !.idea/inspectionProfiles/
.idea/

# ---------- 其他编辑器 ----------
.vscode/
.spyderproject/
.spyproject/
.ropeproject/
tempCodeRunnerFile.py

# ---------- 操作系统 ----------
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
*.lnk

# ---------- 构建留档（按 04 文档约定不入库）----------
requirements-lock.txt

# ---------- 以下目录与文件必须入库（显式声明，防止被上面的规则误伤）----------
# src/          源码（config/pieces/board/game/storage/resource/audio + ui/）
# tests/        pytest 单元测试
# tools/        素材生成脚本（gen_sprites.py / gen_audio.py）
# docs/         8 篇设计文档
# screenshots/  运行截图（start/play/clear/pause/gameover/ranking.png）
# assets/       全部随包素材：icon.ico、icon.png、fonts/msyh.ttc、
#               images/*.png、audio/*.wav（10 个）
# main.py / requirements.txt / pytest.ini / README.md / LICENSE
#
# 注意：assets/ 下的 .ico / .ttc / .png / .wav 全部是运行必需资源，
#       不要新增 *.png、*.wav、*.ico、*.ttc 之类的忽略规则。
